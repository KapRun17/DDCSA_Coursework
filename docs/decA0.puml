@startuml
title IDEF0 A0 — Декомпозиция процесса поиска команды

left to right direction

skinparam rectangle {
  BackgroundColor #F9F9F9
  BorderColor #222222
}

rectangle "A1\nЗарегистрировать и\nавторизовать пользователя" as A1
rectangle "A2\nСформировать игровой\nпрофиль и шаблоны" as A2
rectangle "A3\nОпубликовать и\nобработать заявку" as A3
rectangle "A4\nНайти заявку и\nотправить отклик" as A4
rectangle "A5\nОрганизовать обмен\nсообщениями" as A5

rectangle "Данные пользователя" as Input1
rectangle "Игровые параметры" as Input2
rectangle "Параметры поиска" as Input3

rectangle "Учетная запись\nи активная сессия" as Out1
rectangle "Шаблон игрока\nили команды" as Out2
rectangle "Опубликованная заявка" as Out3
rectangle "Отклик на заявку" as Out4
rectangle "Диалог и сообщения" as Out5

Input1 --> A1
A1 --> Out1
Out1 --> A2

Input2 --> A2
A2 --> Out2
Out2 --> A3

A3 --> Out3
Input3 --> A4
Out3 --> A4

A4 --> Out4
Out4 --> A5
A5 --> Out5

@enduml
